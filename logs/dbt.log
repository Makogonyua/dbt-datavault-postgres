    WHERE b.ORDER_HASHDIFF != b.prev_hashdiff
),

records_to_insert AS (
        SELECT frin.ORDER_PK, frin.ORDER_HASHDIFF, frin.order_date, frin.status, frin.EFFECTIVE_FROM, frin.LOAD_DATE, frin.RECORD_SOURCE
