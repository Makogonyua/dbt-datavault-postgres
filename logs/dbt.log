               PARTITION BY current_records.CUSTOMER_PK
               ORDER BY current_records.LOAD_DATE DESC
            ) AS rank
        FROM "postgres"."dbt"."sat_customer" AS current_records
            JOIN (
                SELECT DISTINCT source_data.CUSTOMER_PK
                FROM source_data
            ) AS source_records
                ON source_records.CUSTOMER_PK = current_records.CUSTOMER_PK
    ) AS b
    WHERE b.rank = 1
),

unique_source_records AS (
    SELECT
        b.CUSTOMER_PK, b.CUSTOMER_HASHDIFF, b.first_name, b.last_name, b.id, b.EFFECTIVE_FROM, b.LOAD_DATE, b.RECORD_SOURCE
    FROM (
