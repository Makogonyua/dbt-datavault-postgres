    p as p8
     cross join 
    
    p as p9
     cross join 
    
    p as p10
     cross join 
    
    p as p11
     cross join 
    
    p as p12
    
    

    )

    select *
    from unioned
    where generated_number <= 4169
    order by generated_number



),

all_periods as (

    select (
        

    TO_DATE('2015/01/01', 'yyyy/mm/dd') + ((interval '1 day') * (row_number() over (order by generated_number) - 1))


    ) as date_day
    from rawdata

),

filtered as (

    select *
    from all_periods
    where date_day <= TO_DATE('2026/06/01', 'yyyy/mm/dd')

)

