  create temporary table "customer_pit__dbt_tmp141558714344"
  as (
    








-- Generated by AutomateDV (formerly known as dbtvault)
        -- depends_on: "postgres"."dbt"."stg_customers"
        -- depends_on: "postgres"."dbt"."stg_customers_crm"

WITH as_of_dates AS (
    SELECT * FROM "postgres"."dbt"."as_of_date"
),

last_safe_load_datetime AS (
    SELECT MIN(LOAD_DATETIME) AS LAST_SAFE_LOAD_DATETIME
    FROM (

        SELECT MIN(load_date) AS LOAD_DATETIME FROM "postgres"."dbt"."stg_customers"
             UNION ALL 
        SELECT MIN(load_date) AS LOAD_DATETIME FROM "postgres"."dbt"."stg_customers_crm"
            
        ) AS l
),

as_of_grain_old_entries AS (
    SELECT DISTINCT AS_OF_DATE
    FROM "postgres"."dbt"."customer_pit"
),

as_of_grain_lost_entries AS (
    SELECT a.AS_OF_DATE
    FROM as_of_grain_old_entries AS a
    LEFT OUTER JOIN as_of_dates AS b
        ON a.AS_OF_DATE = b.AS_OF_DATE
    WHERE b.AS_OF_DATE IS NULL
),

as_of_grain_new_entries AS (
    SELECT a.AS_OF_DATE
    FROM as_of_dates AS a
    LEFT OUTER JOIN as_of_grain_old_entries AS b
        ON a.AS_OF_DATE = b.AS_OF_DATE
    WHERE b.AS_OF_DATE IS NULL
),

min_date AS (
    SELECT MIN(AS_OF_DATE) AS MIN_DATE
    FROM as_of_dates
),

backfill_as_of AS (
    SELECT AS_OF_DATE
    FROM as_of_dates AS a

    
    WHERE a.AS_OF_DATE < (SELECT LAST_SAFE_LOAD_DATETIME FROM last_safe_load_datetime)
),

new_rows_pks AS (
    SELECT h.customer_pk
    FROM "postgres"."dbt"."hub_customer" AS h

    
    WHERE h.load_date >= (SELECT LAST_SAFE_LOAD_DATETIME FROM last_safe_load_datetime)
),

new_rows_as_of AS (
    SELECT AS_OF_DATE
    FROM as_of_dates AS a
    
    WHERE a.AS_OF_DATE >= (SELECT LAST_SAFE_LOAD_DATETIME FROM last_safe_load_datetime)
    UNION
    SELECT as_of_date
    FROM as_of_grain_new_entries
),

overlap_pks AS (
    SELECT a.*
    FROM "postgres"."dbt"."customer_pit" AS a
    INNER JOIN "postgres"."dbt"."hub_customer" as b
        ON a.customer_pk = b.customer_pk
    
    WHERE a.AS_OF_DATE >= (SELECT MIN_DATE FROM min_date)
        AND a.AS_OF_DATE < (SELECT LAST_SAFE_LOAD_DATETIME FROM last_safe_load_datetime)
        AND a.AS_OF_DATE NOT IN (SELECT AS_OF_DATE FROM as_of_grain_lost_entries)
),

overlap_as_of AS (
    SELECT p.AS_OF_DATE
    FROM as_of_dates AS p
    
    WHERE p.AS_OF_DATE >= (SELECT MIN_DATE FROM min_date)
        AND p.AS_OF_DATE < (SELECT LAST_SAFE_LOAD_DATETIME FROM last_safe_load_datetime)
        AND p.AS_OF_DATE NOT IN (SELECT AS_OF_DATE FROM as_of_grain_lost_entries)
    
),

backfill_rows_as_of_dates AS (
    SELECT
        a.customer_pk,
        b.AS_OF_DATE
    FROM new_rows_pks AS a
    INNER JOIN backfill_as_of AS b
        ON (1=1)
),

backfill AS (
    SELECT
        a.customer_pk,
        a.AS_OF_DATE,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_PK,

        COALESCE(MAX(sat_customer_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_LDTS,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_crm_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_crm_PK,

        COALESCE(MAX(sat_customer_crm_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_crm_LDTS

    FROM backfill_rows_as_of_dates AS a

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer" AS sat_customer_src
            ON a.customer_pk = sat_customer_src.customer_pk
            AND sat_customer_src.load_date <= a.AS_OF_DATE
    

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer_crm" AS sat_customer_crm_src
            ON a.customer_pk = sat_customer_crm_src.customer_pk
            AND sat_customer_crm_src.load_date <= a.AS_OF_DATE
    

    GROUP BY
        a.customer_pk, a.AS_OF_DATE
),

new_rows_as_of_dates AS (
    SELECT
        a.customer_pk,
        b.AS_OF_DATE
    FROM "postgres"."dbt"."hub_customer" AS a
    INNER JOIN new_rows_as_of AS b
    ON (1=1)
),

new_rows AS (
    SELECT
        a.customer_pk,
        a.AS_OF_DATE,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_PK,

        COALESCE(MAX(sat_customer_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_LDTS,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_crm_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_crm_PK,

        COALESCE(MAX(sat_customer_crm_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_crm_LDTS

    FROM new_rows_as_of_dates AS a

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer" AS sat_customer_src
            ON a.customer_pk = sat_customer_src.customer_pk
            AND sat_customer_src.load_date <= a.AS_OF_DATE
    

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer_crm" AS sat_customer_crm_src
            ON a.customer_pk = sat_customer_crm_src.customer_pk
            AND sat_customer_crm_src.load_date <= a.AS_OF_DATE
    

    GROUP BY
        a.customer_pk,
        a.AS_OF_DATE
),

pit AS (
    SELECT * FROM new_rows
    UNION ALL
    SELECT * FROM overlap_pks
    UNION ALL
    SELECT * FROM backfill
    
)

SELECT DISTINCT * FROM pit
  );
  
  
