  create temporary table "sat_customer_crm__dbt_tmp141557362416"
  as (
    -- Generated by AutomateDV (formerly known as dbtvault)

    

WITH source_data AS (
    SELECT a.CUSTOMER_PK, a.CUSTOMER_HASHDIFF, a.age, a.country, a.EFFECTIVE_FROM, a.LOAD_DATE, a.RECORD_SOURCE
    FROM "postgres"."dbt"."stg_customers_crm" AS a
    WHERE a.CUSTOMER_PK IS NOT NULL
),

latest_records AS (
    SELECT b.CUSTOMER_PK, b.CUSTOMER_HASHDIFF, b.age, b.country, b.EFFECTIVE_FROM, b.LOAD_DATE, b.RECORD_SOURCE
    FROM (
        SELECT current_records.CUSTOMER_PK, current_records.CUSTOMER_HASHDIFF, current_records.age, current_records.country, current_records.EFFECTIVE_FROM, current_records.LOAD_DATE, current_records.RECORD_SOURCE,
            RANK() OVER (
               PARTITION BY current_records.CUSTOMER_PK
               ORDER BY current_records.LOAD_DATE DESC
            ) AS rank
        FROM "postgres"."dbt"."sat_customer_crm" AS current_records
            JOIN (
                SELECT DISTINCT source_data.CUSTOMER_PK
                FROM source_data
            ) AS source_records
                ON source_records.CUSTOMER_PK = current_records.CUSTOMER_PK
    ) AS b
    WHERE b.rank = 1
),

first_record_in_set AS (
    SELECT * FROM (
        SELECT
        sd.CUSTOMER_PK, sd.CUSTOMER_HASHDIFF, sd.age, sd.country, sd.EFFECTIVE_FROM, sd.LOAD_DATE, sd.RECORD_SOURCE,
        RANK() OVER (
                PARTITION BY sd.CUSTOMER_PK
                ORDER BY sd.LOAD_DATE ASC
            ) as asc_rank
        FROM source_data as sd
    ) AS rin
    WHERE rin.asc_rank = 1
),

unique_source_records AS (
    SELECT
        b.CUSTOMER_PK, b.CUSTOMER_HASHDIFF, b.age, b.country, b.EFFECTIVE_FROM, b.LOAD_DATE, b.RECORD_SOURCE
    FROM (
        SELECT DISTINCT
            sd.CUSTOMER_PK, sd.CUSTOMER_HASHDIFF, sd.age, sd.country, sd.EFFECTIVE_FROM, sd.LOAD_DATE, sd.RECORD_SOURCE,
            LAG(sd.CUSTOMER_HASHDIFF) OVER (
                PARTITION BY sd.CUSTOMER_PK
                ORDER BY sd.LOAD_DATE ASC) as prev_hashdiff
        FROM source_data as sd
        ) AS b
    WHERE b.CUSTOMER_HASHDIFF != b.prev_hashdiff
),

records_to_insert AS (
        SELECT frin.CUSTOMER_PK, frin.CUSTOMER_HASHDIFF, frin.age, frin.country, frin.EFFECTIVE_FROM, frin.LOAD_DATE, frin.RECORD_SOURCE
        FROM first_record_in_set AS frin
        LEFT JOIN LATEST_RECORDS lr
            ON lr.CUSTOMER_PK = frin.CUSTOMER_PK
            AND lr.CUSTOMER_HASHDIFF = frin.CUSTOMER_HASHDIFF
            WHERE lr.CUSTOMER_HASHDIFF IS NULL
        UNION
        SELECT usr.CUSTOMER_PK, usr.CUSTOMER_HASHDIFF, usr.age, usr.country, usr.EFFECTIVE_FROM, usr.LOAD_DATE, usr.RECORD_SOURCE
        FROM unique_source_records as usr
)

SELECT * FROM records_to_insert
  );
  
  
