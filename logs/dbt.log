    select hc.customer_pk,
    sc.last_name,
    sc.first_name,
    scc.age,
    sc.effective_from as sc_effective_from,
                  coalesce(lead(sc.effective_from) OVER (PARTITION BY hc.customer_pk ORDER BY sc.effective_from), '9999-12-31') as sc_effective_to,
