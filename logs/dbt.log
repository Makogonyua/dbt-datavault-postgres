  as (
    








-- Generated by AutomateDV (formerly known as dbtvault)

WITH as_of_dates AS (
    SELECT * FROM "postgres"."dbt"."as_of_date"
),

new_rows_as_of_dates AS (
    SELECT
        a.customer_pk,
        b.AS_OF_DATE
    FROM "postgres"."dbt"."hub_customer" AS a
    INNER JOIN as_of_dates AS b
    ON (1=1)
),

new_rows AS (
    SELECT
        a.customer_pk,
        a.AS_OF_DATE,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_PK,

        COALESCE(MAX(sat_customer_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_LDTS,

        COALESCE(DECODE(MAX(ENCODE(sat_customer_crm_src.customer_pk, 'hex')), 'hex'),
                 CAST('0000000000000000' AS BYTEA))
        AS sat_customer_crm_PK,

        COALESCE(MAX(sat_customer_crm_src.load_date),
                 to_char(timestamp '1900-01-01 00:00:00.000', 'YYYY-MM-DD HH24:MI:SS.MS')::timestamp)
        AS sat_customer_crm_LDTS

    FROM new_rows_as_of_dates AS a

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer" AS sat_customer_src
            ON a.customer_pk = sat_customer_src.customer_pk
            AND sat_customer_src.load_date <= a.AS_OF_DATE
    

        LEFT OUTER JOIN "postgres"."dbt"."sat_customer_crm" AS sat_customer_crm_src
            ON a.customer_pk = sat_customer_crm_src.customer_pk
            AND sat_customer_crm_src.load_date <= a.AS_OF_DATE
    

    GROUP BY
        a.customer_pk,
        a.AS_OF_DATE
),

pit AS (
    SELECT * FROM new_rows
)

SELECT DISTINCT * FROM pit
  );
  
